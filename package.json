{
  "name": "delta-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=5000 --host=0.0.0.0",
    "server": "node dist/index.cjs",
    "build": "vite build && node_modules/.bin/esbuild server/index.ts --platform=node --bundle --format=cjs --outfile=dist/index.cjs --external:pg-native --external:bufferutil --external:utf-8-validate --external:nodemailer && cp dist/index.cjs server.cjs",
    "start": "node dist/index.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "seed:stripe": "tsx scripts/seed-stripe-products.ts",
    "postinstall": "node scripts/patch-postcss.cjs && node scripts/setup-hooks.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "stripe": "^22.3.1",
    "tsx": "^4.23.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.28.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "patch-package": "^8.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}

# PostgreSQL connection string (required)
# Get this from Supabase: Dashboard → Settings → Database → Connection string → URI
# Use the Direct connection (port 5432), not the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Secret key for signing JWT tokens (required)
# Use a long random string — generate one at: https://generate-secret.vercel.app/64
JWT_SECRET="change-me-to-a-long-random-secret"

# Supabase project settings used for native password-recovery emails.
# The public/anon key is safe for this server-side request, but keep the
# service-role key private because it is also used for account synchronization.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Set to "production" when deploying
NODE_ENV="production"

# Public browser URL used for password-recovery redirects.
# Set this to the deployed HTTPS origin (for example, https://deltarush.win).
# For Replit development, the server can use REPLIT_DEV_DOMAIN automatically.
APP_URL=""
